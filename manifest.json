{
  "manifest_version": 3,
  "name": "Soifon",
  "version": "1.0",
  "description": "Copy session token and SAML assertion value for CLI use",
  "permissions": [
    "webRequest",
    "storage",
    "cookies",
    "scripting",
    "offscreen",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
